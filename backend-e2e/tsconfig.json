{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "../dist/out-tsc",
    "sourceMap": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "**/*.js",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts"
  ]
}
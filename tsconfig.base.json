{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@erp/backend-database": [
        "./libs/backend/database/src/index.ts"
      ],
      "@erp/backend-inventory": [
        "./libs/backend/inventory/src/index.ts"
      ],
      "@erp/backend-sales": [
        "./libs/backend/sales/src/index.ts"
      ],
      "@erp/shared-ui": [
        "./libs/shared/ui/src/index.ts"
      ],
      "@erp/shared-api": [
        "./libs/shared/api/src/index.ts"
      ],
      "@erp/shared-auth": [
        "./libs/shared/authlib/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}

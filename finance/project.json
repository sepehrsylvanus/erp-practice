{
  "name": "finance",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "finance/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "vite",
        "cwd": "finance"
      },
      "dependsOn": [
        "shell:serve"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "finance"
      }
    }
  }
}
